# ============================================================
# SITAO.fun — Environment Variables
# ============================================================
# Скопіюй цей файл як .env.local та заповни всі значення
# НІКОЛИ не пушь .env.local у git!
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Знайдеш у: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key — ТІЛЬКИ сервер, ніколи клієнт!
# Знайдеш у: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Шифрування ───────────────────────────────────────────────
# Генерація: node scripts/generate-key.mjs
# 64 hex-символи (32 байти / AES-256-GCM)
ENCRYPTION_KEY=your_64_hex_characters_encryption_key_here

# ── Сайт ─────────────────────────────────────────────────────
# URL твого сайту (для CORS та email посилань)
NEXT_PUBLIC_SITE_URL=https://sitao.fun

# У режимі розробки:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (опціонально, якщо кастомний SMTP) ─────────────────
# Supabase вже має вбудований email, але якщо хочеш свій:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password

# ── Платіжна система (опціонально) ───────────────────────────
# WAYFORPAY_MERCHANT_ACCOUNT=your_merchant
# WAYFORPAY_SECRET_KEY=your_secret
